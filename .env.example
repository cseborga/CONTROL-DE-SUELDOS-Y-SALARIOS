# ========================================================
# MORALES LARRAZÁBAL M.L. - VARIABLES DE ENTORNO (TEMPLATE)
# ========================================================

# Puerto del servidor Backend
PORT=3000

# Entorno de ejecución: development | production | test
NODE_ENV=production

# Conexión a la Base de Datos PostgreSQL (Neon / Supabase / Koyeb)
# Formato: postgresql://<usuario>:<password>@<host>:<puerto>/<base_de_datos>?sslmode=require
DATABASE_URL=postgresql://usuario_ml:password_seguro@ep-cool-db.us-east-2.aws.neon.tech/planilla_ml?sslmode=require

# Clave secreta para generación de tokens de sesión JWT
JWT_SECRET=ml_consultoria_construccion_secret_key_2026_super_secure

# Tiempo de expiración del token (ej. 8h, 24h, 7d)
JWT_EXPIRES_IN=24h

# Orígenes CORS permitidos (separados por coma si son varios)
# Para el ejecutable portable local se puede permitir * o app://localhost
CORS_ORIGIN=*

# Nivel de registro de logs: debug | info | warn | error
LOG_LEVEL=info
